<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Xrash Report</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>wiki.qaq.xrash.report</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Diagnostic Report</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.ips</string>
				<string>com.apple.crashreport</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Debug Symbols</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.xcode.dsym</string>
				<string>public.zip-archive</string>
			</array>
		</dict>
	</array>
	<!--
		The app opens what it is handed where it lies; nothing arrives in an
		Inbox copy first. Every route that takes an external URL therefore
		brackets it with start/stopAccessingSecurityScopedResource and copies
		whatever it means to keep (ExternalFileRouter, DSYMImport). NO is not
		supported on macOS — Catalyst warns and ignores it — and a Finder drop
		hands over the file where it lies either way.
	-->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<false/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Xrash Report</string>
			<key>UTTypeIdentifier</key>
			<string>wiki.qaq.xrash.report</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>xrashreport</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Diagnostic Report</string>
			<key>UTTypeIdentifier</key>
			<string>com.apple.ips</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ips</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Crash Report</string>
			<key>UTTypeIdentifier</key>
			<string>com.apple.crashreport</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>crash</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Debug Symbols</string>
			<key>UTTypeIdentifier</key>
			<string>com.apple.xcode.dsym</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>dSYM</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
