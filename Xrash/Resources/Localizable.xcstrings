    "Hidden processes and the kinds you turned off stay quiet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى العمليات المخفية والأنواع التي أوقفتها صامتة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeblendete Prozesse und deaktivierte Arten bleiben still."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidden processes and the kinds you turned off stay quiet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los procesos ocultos y los tipos desactivados no avisan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les processus masqués et les types désactivés restent silencieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I processi nascosti e i tipi disattivati restano in silenzio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示にしたプロセスやオフにした種類は通知されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨긴 프로세스와 꺼 둔 종류는 알리지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processos ocultos e tipos desativados ficam em silêncio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрытые процессы и отключённые типы не беспокоят."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiến trình đã ẩn và các loại đã tắt sẽ không thông báo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已隐藏的进程和已关闭的类型不会通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已隱藏的程序和已關閉的類型不會通知。"
          }
        }
      }
    },
    "Hidden processes stay off the list and do not send notifications. Reports on disk are not deleted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العمليات المخفية لا تظهر في القائمة ولا ترسل إشعارات. ولا تُحذف التقارير المخزّنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeblendete Prozesse erscheinen nicht in der Liste und senden keine Mitteilungen. Die Berichte auf dem Datenträger werden nicht gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidden processes stay off the list and do not send notifications. Reports on disk are not deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los procesos ocultos no aparecen en la lista ni envían notificaciones. Los informes guardados no se eliminan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les processus masqués n’apparaissent pas dans la liste et n’envoient aucune notification. Les rapports stockés ne sont pas supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I processi nascosti restano fuori dall’elenco e non inviano notifiche. I rapporti sul disco non vengono eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示のプロセスはリストに表示されず、通知も送信されません。ディスク上のレポートは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨긴 프로세스는 목록에 표시되지 않고 알림도 보내지 않습니다. 디스크에 있는 보고서는 삭제되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os processos ocultos ficam fora da lista e não enviam notificações. Os relatórios armazenados não são apagados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрытые процессы не попадают в список и не присылают уведомления. Отчёты в хранилище не удаляются."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tiến trình đã ẩn sẽ không xuất hiện trong danh sách và không gửi thông báo. Báo cáo đã lưu không bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏的进程不会出现在列表中，也不会发送通知。磁盘上的报告不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏的程序不會出現在列表中，也不會發送通知。磁碟上的報告不會被刪除。"
          }
        }
      }
    },
