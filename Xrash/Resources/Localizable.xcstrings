    "Most of what the system writes is analytics and logs, not crashes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معظم ما يكتبه النظام هو تحليلات وسجلات، وليس تعطلات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das meiste, was das System schreibt, sind Analysedaten und Protokolle, keine Abstürze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most of what the system writes is analytics and logs, not crashes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayor parte de lo que escribe el sistema son análisis y registros, no fallos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’essentiel de ce que le système écrit relève de l’analyse et des journaux, pas des plantages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maggior parte di ciò che il sistema scrive sono analisi e log, non crash."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムが書き出すものの大半は分析データとログで、クラッシュではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템이 기록하는 대부분은 분석 및 로그이며, 크래시가 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maior parte do que o sistema grava são análises e registros, não falhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большая часть того, что пишет система, — это аналитика и журналы, а не сбои."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phần lớn những gì hệ thống ghi lại là phân tích và nhật ký, không phải sự cố."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统写入的内容大多是分析数据与日志，而非崩溃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統寫入的內容大多是分析資料與記錄，而非崩潰。"
          }
        }
      }
