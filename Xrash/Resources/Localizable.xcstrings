          "stringUnit" : {
            "state" : "translated",
            "value" : "Состояние системы"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trạng thái hệ thống"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
