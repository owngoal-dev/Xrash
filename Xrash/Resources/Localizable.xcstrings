    "This binary could not be opened. It may belong to another device, or to software that is no longer installed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر فتح هذا الملف الثنائي. قد يكون تابعًا لجهاز آخر، أو لبرنامج لم يعد مثبتًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Binärdatei konnte nicht geöffnet werden. Sie gehört möglicherweise zu einem anderen Gerät oder zu Software, die nicht mehr installiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This binary could not be opened. It may belong to another device, or to software that is no longer installed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido abrir este binario. Puede que sea de otro dispositivo o de software que ya no está instalado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce binaire n’a pas pu être ouvert. Il appartient peut-être à un autre appareil ou à un logiciel qui n’est plus installé."
          }
        },
