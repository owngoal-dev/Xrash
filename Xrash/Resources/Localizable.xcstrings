    "A crash loop becomes one pile, not a wall of banners." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتجمّع حلقة الأعطال في مجموعة واحدة، لا في جدار من الإشعارات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Absturzschleife wird zu einem Stapel, nicht zu einer Wand aus Bannern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A crash loop becomes one pile, not a wall of banners."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bucle de fallos se agrupa en una sola pila, no en un muro de avisos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une boucle de plantages forme une seule pile, pas un mur de bannières."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ciclo di crash diventa un solo gruppo, non un muro di banner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュが繰り返されても、通知は 1 つの束にまとまります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충돌이 반복되어도 알림은 한 묶음으로 쌓입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um loop de falhas vira uma pilha só, não uma parede de avisos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цикл сбоев складывается в одну стопку, а не в стену баннеров."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vòng lặp sự cố gom thành một chồng, không phải một bức tường thông báo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反复崩溃只会叠成一组，不会刷满屏幕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反覆當機只會疊成一組，不會洗版。"
          }
        }
      }
    },
    "A dSYM names the addresses in your own code." : {
