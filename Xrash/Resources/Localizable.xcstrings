        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez les notifications pour Xrash dans Réglages pour être averti à l’arrivée d’un rapport."
          }
        },
        "it" : {
          "stringUnit" : {
