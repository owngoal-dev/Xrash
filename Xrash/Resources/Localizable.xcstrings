            "value" : "y %lld imágenes del sistema, omitidas por ser de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "et %lld images système, exclues car elles appartiennent à Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e %lld immagini di sistema, escluse perché sono di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "および、Apple のものであるため除外したシステムイメージ %lld 個。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그리고 Apple의 것이라 제외된 시스템 이미지 %lld개."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e mais %lld imagens do sistema, deixadas de fora por serem da Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "и ещё %lld системных образов, пропущенных, так как они принадлежат Apple."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "và %lld ảnh nhị phân hệ thống, bị bỏ qua vì thuộc về Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以及 %lld 个系统映像，因属于 Apple 而未包含。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以及 %lld 個系統映像，因屬於 Apple 而未包含。"
          }
        }
      }
    },
