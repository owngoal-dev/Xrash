    "The stored tables are removed and system frames go back to addresses until they are extracted again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُزال الجداول المخزَّنة وتعود إطارات النظام إلى عناوين حتى تُستخرج من جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gesicherten Tabellen werden entfernt, und System-Frames zeigen wieder Adressen, bis sie erneut extrahiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The stored tables are removed and system frames go back to addresses until they are extracted again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan las tablas guardadas y los marcos del sistema vuelven a ser direcciones hasta que se extraigan de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tables enregistrées sont supprimées et les frames système redeviennent des adresses jusqu’à une nouvelle extraction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tabelle salvate vengono rimosse e i frame di sistema tornano a essere indirizzi finché non vengono estratti di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたテーブルが削除され、もう一度抽出するまでシステムのフレームはアドレスに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 테이블이 삭제되고, 다시 추출할 때까지 시스템 프레임은 주소로만 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tabelas armazenadas são removidas e os quadros do sistema voltam a ser endereços até serem extraídos novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённые таблицы удаляются, и системные кадры снова станут адресами, пока их не извлекут заново."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bảng đã lưu sẽ bị gỡ và khung ngăn xếp hệ thống trở lại thành địa chỉ cho tới khi được trích xuất lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已存储的符号表将被移除，系统帧会恢复为地址，直到重新提取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的符號表會被移除，系統堆疊框架會恢復為位址，直到重新提取為止。"
          }
        }
      }
    },
