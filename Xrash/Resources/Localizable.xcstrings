    "Installed apps, packages, tweaks, running processes and services are included. Review them before sharing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتضمن التطبيقات والحزم والتعديلات المثبّتة، والعمليات والخدمات قيد التشغيل. راجعها قبل المشاركة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installierte Apps, Pakete und Tweaks sowie laufende Prozesse und Dienste sind enthalten. Sieh sie dir vor dem Teilen an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installed apps, packages, tweaks, running processes and services are included. Review them before sharing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se incluyen las apps, los paquetes y los tweaks instalados, así como los procesos y servicios en ejecución. Revísalos antes de compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps, paquets et tweaks installés ainsi que les processus et services en cours d’exécution sont inclus. Examinez-les avant de partager."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono inclusi app, pacchetti e tweak installati, oltre ai processi e ai servizi in esecuzione. Controllali prima di condividere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みの App、パッケージ、Tweak と、実行中のプロセスおよびサービスが含まれます。共有する前に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치된 앱, 패키지, 트윅과 실행 중인 프로세스 및 서비스가 포함됩니다. 공유하기 전에 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São incluídos os apps, pacotes e tweaks instalados, além dos processos e serviços em execução. Revise-os antes de compartilhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включены установленные приложения, пакеты и твики, а также запущенные процессы и службы. Просмотрите их перед отправкой."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bao gồm các ứng dụng, gói và tweak đã cài đặt cùng các tiến trình và dịch vụ đang chạy. Hãy xem lại trước khi chia sẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中包含已安装的应用、软件包和插件，以及正在运行的进程和服务。共享前请先查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中包含已安裝的 App、套件和外掛，以及正在執行的程序和服務。分享前請先查看。"
          }
        }
      }
    },
