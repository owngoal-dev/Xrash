          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crash che sembrano far parte dello stesso incidente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じインシデントの一部と思われるクラッシュです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 인시던트의 일부로 보이는 크래시입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falhas que parecem fazer parte do mesmo incidente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбои, которые выглядят частью одного инцидента."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những sự cố có vẻ thuộc cùng một vụ việc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
