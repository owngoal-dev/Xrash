          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow notifications for Xrash in Settings to be told when a report arrives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriza las notificaciones de Xrash en Ajustes para saber cuándo llega un informe."
