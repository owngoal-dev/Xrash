    "Use Report Crash on any report to bundle it with related crashes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم “الإبلاغ عن التعطل” على أي تقرير لتجميعه مع التعطلات ذات الصلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende „Absturz melden“ bei einem beliebigen Bericht, um ihn mit verwandten Abstürzen zu bündeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Report Crash on any report to bundle it with related crashes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa “Informar del fallo” en cualquier informe para agruparlo con los fallos relacionados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez « Signaler un plantage » sur un rapport pour le regrouper avec les plantages liés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa “Segnala un crash” su un rapporto qualsiasi per raggrupparlo con i crash correlati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のレポートで「クラッシュを報告」を使うと、関連するクラッシュとまとめられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무 보고서에서 ‘크래시 보고’를 사용해 관련 크래시와 함께 묶으세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use “Relatar Falha” em qualquer relatório para agrupá-lo com as falhas relacionadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите «Сообщить о сбое» в любом отчёте, чтобы собрать его вместе со связанными сбоями."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng “Báo cáo sự cố” trên bất kỳ báo cáo nào để gộp nó với các sự cố liên quan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对任意报告使用“报告崩溃”，即可将它与相关的崩溃打包在一起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對任一報告使用「回報崩潰」，即可將它與相關的崩潰打包在一起。"
          }
        }
      }
    },
