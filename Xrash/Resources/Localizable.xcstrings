            "value" : "أدخله بصيغة owner/repo، أو الصق عنوان المستودع على GitHub."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib es als owner/repo ein oder füge die GitHub-Adresse des Repositorys ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter it as owner/repo, or paste the repository's GitHub address."
          }
        },
