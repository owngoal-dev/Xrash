    "System symbols and imported dSYMs turn a stack of addresses into function names." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحوّل رموز النظام وملفات dSYM المستوردة مكدسًا من العناوين إلى أسماء دوال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemsymbole und importierte dSYMs machen aus einem Stack von Adressen Funktionsnamen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System symbols and imported dSYMs turn a stack of addresses into function names."
          }
