      }
    },
    "A new report is announced even while Xrash is not running." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعلَن عن التقرير الجديد حتى عندما لا يكون Xrash قيد التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
