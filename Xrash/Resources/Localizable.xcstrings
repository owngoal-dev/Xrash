    "Every image in this build's shared cache is read and stored, which takes more than a gigabyte of space and several minutes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُقرأ كل صورة في ذاكرة التخزين المشتركة لهذا الإصدار وتُخزَّن، وهذا يستهلك أكثر من جيجابايت من المساحة وعدة دقائق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Image im Shared Cache dieses Builds wird gelesen und gesichert; das braucht mehr als ein Gigabyte Speicher und mehrere Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every image in this build's shared cache is read and stored, which takes more than a gigabyte of space and several minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lee y se guarda cada imagen de la caché compartida de esta compilación, lo que ocupa más de un gigabyte y tarda varios minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque image du cache partagé de ce build est lue et conservée, ce qui occupe plus d’un gigaoctet et prend plusieurs minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni immagine nella shared cache di questa build viene letta e salvata: richiede più di un gigabyte di spazio e diversi minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドの共有キャッシュにあるすべてのイメージを読み込んで保存します。1 GB を超える空き容量と数分の時間がかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 빌드의 공유 캐시에 있는 모든 이미지를 읽어 저장하므로 1GB가 넘는 공간과 몇 분이 걸립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada imagem do cache compartilhado desta versão é lida e armazenada, o que ocupa mais de um gigabyte e leva vários minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый образ из общего кэша этой сборки читается и сохраняется: это занимает больше гигабайта места и несколько минут."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi ảnh nhị phân trong bộ nhớ đệm dùng chung của bản dựng này đều được đọc và lưu lại, việc này tốn hơn một gigabyte dung lượng và vài phút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本共享缓存中的每个映像都会被读取并存储，这需要 1 GB 以上的空间和数分钟时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本共享快取中的每個映像都會被讀取並儲存，這需要 1 GB 以上的空間和數分鐘時間。"
          }
        }
      }
    },
