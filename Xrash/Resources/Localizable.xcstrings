          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起來屬於同一事件的崩潰。"
          }
        }
      }
    },
    "Crashes, hangs, kernel panics and out-of-memory reports, as the system wrote them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقارير التعطل والتجمد وذعر النواة ونفاد الذاكرة، كما كتبها النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstürze, Hänger, Kernel-Panics und Berichte über Speichermangel, so wie das System sie geschrieben hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crashes, hangs, kernel panics and out-of-memory reports, as the system wrote them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallos, bloqueos, pánicos del kernel e informes de falta de memoria, tal como los ha escrito el sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plantages, blocages, kernel panics et rapports de mémoire insuffisante, tels que le système les a écrits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crash, blocchi, kernel panic e rapporti di memoria esaurita, così come li ha scritti il sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュ、ハング、カーネルパニック、メモリ不足のレポートを、システムが書き出したままの形で表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크래시, 멈춤, 커널 패닉, 메모리 부족 보고서를 시스템이 기록한 그대로 보여줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falhas, travamentos, pânicos do kernel e relatórios de falta de memória, exatamente como o sistema os escreveu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбои, зависания, паники ядра и отчёты о нехватке памяти — в том виде, в каком их записала система."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự cố, treo, kernel panic và báo cáo hết bộ nhớ, đúng như hệ thống đã ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "崩溃、无响应、内核崩溃和内存不足报告，与系统写下的内容一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "崩潰、無回應、核心崩潰和記憶體不足報告，與系統寫下的內容一致。"
          }
        }
      }
    },
