    "Extracted once per system version, so system frames have names in every report." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخرج مرة واحدة لكل إصدار من النظام، لتظهر أسماء إطارات النظام في كل تقرير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal pro Systemversion extrahiert, damit System-Frames in jedem Bericht Namen haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extracted once per system version, so system frames have names in every report."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se extraen una vez por cada versión del sistema, para que los marcos del sistema tengan nombre en todos los informes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extraits une fois par version du système, pour que les frames système portent un nom dans chaque rapport."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estratti una volta per ogni versione del sistema, così i frame di sistema hanno un nome in ogni rapporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムのバージョンごとに一度抽出すれば、どのレポートでもシステムのフレームに名前が付きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 버전마다 한 번만 추출하면 모든 보고서에서 시스템 프레임에 이름이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extraídos uma vez por versão do sistema, para que os quadros do sistema tenham nome em todos os relatórios."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Извлекаются один раз для каждой версии системы, чтобы системные кадры имели имена в каждом отчёте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ cần trích xuất một lần cho mỗi phiên bản hệ thống, để khung ngăn xếp của hệ thống có tên trong mọi báo cáo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个系统版本只需提取一次，之后每份报告中的系统帧都会有名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個系統版本只需提取一次，之後每份報告中的系統堆疊框架都會有名稱。"
          }
        }
      }
    },
