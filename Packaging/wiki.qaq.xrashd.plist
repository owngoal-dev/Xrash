<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The install prefix in ProgramArguments is substituted at package time:
	empty for roothide, whose launchctl re-prefixes this rootful path at every
	load, and /var/jb for rootless. Never a resolved bootstrap path.

	xrashd is on-demand: launchd starts it when the app looks the Mach service
	up, or when a report directory changes, and it exits when the last client
	has been gone for a moment. `make check` and both packaging scripts fail on
	KeepAlive or RunAtLoad here.

	WatchPaths is what makes a notification possible while the app is not
	running without a resident process: the crash reporter posts no event of
	its own when a report is written (OSAnalytics has no notify_post for it),
	so the directory changing is the event. The paths are the fixed report
	roots of `ReportRoots`; one that does not exist is ignored by launchd.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>wiki.qaq.xrashd</string>
	<key>ProgramArguments</key>
	<array>
		<string>@PREFIX@/usr/libexec/xrashd</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<!-- Background until the foreground app's XPC request boosts it. -->
	<key>ProcessType</key>
	<string>Adaptive</string>
	<!-- 0022: files the daemon creates are not group- or world-writable. -->
	<key>Umask</key>
	<integer>18</integer>
	<key>MachServices</key>
	<dict>
		<key>wiki.qaq.xrash.service</key>
		<true/>
	</dict>
	<key>WatchPaths</key>
	<array>
		<string>/private/var/mobile/Library/Logs/CrashReporter</string>
		<string>/private/var/root/Library/Logs/CrashReporter</string>
		<string>/Library/Logs/CrashReporter</string>
	</array>
	<!-- Nothing may inject into the process that does privileged work. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>DISABLE_TWEAKS</key>
		<string>1</string>
	</dict>
</dict>
</plist>
